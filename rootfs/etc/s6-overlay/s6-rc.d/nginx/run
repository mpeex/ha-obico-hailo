#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community Add-on: Obico ML (Hailo)
# HA Ingress reverse proxy (nginx) - only accepts 172.30.32.2, proxies to Flask
# ==============================================================================

bashio::log.info 'Starting HA Ingress reverse proxy (nginx)...'

# The Debian default nginx.conf logs to /var/log/nginx/error.log; the minimal
# image does not ship that directory (and the Dockerfile purge removes it), so
# create it here before starting.
mkdir -p /var/log/nginx

exec nginx -g 'daemon off;'