#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community Add-on: Obico ML (Hailo)
# Starts the Obico ML REST API server (Hailo-8 / Hailo-8L backend)
# ==============================================================================
declare -a options

bashio::log.info 'Starting Obico ML REST API server (Hailo)...'

# Frame-rate limit for the shared Hailo device (inferences per second).
# Set from the add-on configuration option `max_fps` (default: 1).
if bashio::config.has_value 'max_fps'; then
    export MAX_FPS="$(bashio::config 'max_fps')"
    bashio::log.info "MAX_FPS=${MAX_FPS}"
fi

# Self-contained camera selection (see lib/ha.py + lib/config_store.py).
# The camera_entity may be left blank and chosen later from the web UI.
if bashio::config.has_value 'camera_entity'; then
    export CAMERA_ENTITY="$(bashio::config 'camera_entity')"
    bashio::log.info "CAMERA_ENTITY=${CAMERA_ENTITY}"
fi
if bashio::config.has_value 'interval'; then
    export INTERVAL="$(bashio::config 'interval')"
fi
if bashio::config.has_value 'threshold'; then
    export THRESHOLD="$(bashio::config 'threshold')"
fi
if bashio::config.true 'auto_start'; then
    export AUTO_START="true"
fi

exec gunicorn --bind 0.0.0.0:3333 --chdir /app --limit-request-line 0 --workers 1 wsgi